# Server Environment Variables
PORT=3001
NODE_ENV=development

# Database (MongoDB Atlas / PostgreSQL)
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/leadgen_db?retryWrites=true&w=majority"

# JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Google Cloud APIs
GOOGLE_API_KEY=your_google_api_key_here

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SMTP Outreach Configurations (e.g., Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Lin's Gen Outreach <your-gmail-email@gmail.com>"

# Twilio WhatsApp Outreach Configurations
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
